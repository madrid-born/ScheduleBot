# Copy to /etc/schedulebot-filelinks.env on Ubuntu, with root ownership and mode 600.
# Replace API ID 0 and the API hash placeholder using https://my.telegram.org/apps.
# This uses your existing bot token; never supply a phone number or user session.
ASPNETCORE_ENVIRONMENT=Production
FileLinks__Enabled=true
FileLinks__UseMtProto=true
FileLinks__PublicBaseUrl=https://telegramdownload.kofi.rest
FileLinks__MtProtoApiId=0
FileLinks__MtProtoApiHash=REPLACE_WITH_API_HASH
FileLinks__MtProtoSessionPath=/var/lib/schedulebot-telegram/filelinks.session
FileLinks__MaxDownloadBytes=4294967296
FileLinks__DownloadTimeoutMinutes=120
